
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IPL Mega Stadium Box Office 2026</title>
    <style>
        :root {
            --primary: #0f172a;
            --secondary: #1e293b;
            --accent: #f59e0b;
            --accent-hover: #d97706;
            --blue-glow: #3b82f6;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --seat-avail: #334155;
            --seat-selected: #10b981;
            --seat-booked: #ef4444;
            --seat-vip: #8b5cf6;
            --pitch-green: #064e3b;
            --border-color: #334155;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }

        body {
            background-color: var(--primary);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Top Navigation Header */
        header {
            background: linear-gradient(135deg, #1e3a8a, #0f172a);
            border-bottom: 1px solid var(--border-color);
            position: sticky;
            top: 0;
            z-index: 50;
            box-shadow: 0 4px 20px rgba(0,0,0,0.5);
        }

        .header-content {
            max-width: 1300px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 20px;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 1.4rem;
            font-weight: 800;
            letter-spacing: 1px;
            color: var(--accent);
            text-transform: uppercase;
        }

        .nav-tabs {
            display: flex;
            gap: 8px;
            background: rgba(0,0,0,0.3);
            padding: 5px;
            border-radius: 10px;
        }

        .tab-btn {
            background: transparent;
            border: none;
            color: var(--text-muted);
            padding: 10px 18px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 0.9rem;
            font-weight: 600;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .tab-btn:hover {
            color: var(--text-main);
            background: rgba(255,255,255,0.05);
        }

        .tab-btn.active {
            background: var(--accent);
            color: #000;
        }

        /* Container & Tabs */
        .container {
            max-width: 1300px;
            margin: 25px auto;
            padding: 0 20px;
            width: 100%;
            flex: 1;
        }

        .tab-panel {
            display: none;
            animation: fadeIn 0.25s ease-in-out;
        }

        .tab-panel.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* SECTION 1: MATCH SELECTION */
        .section-header {
            margin-bottom: 18px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .section-title {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--text-main);
            border-left: 4px solid var(--accent);
            padding-left: 10px;
        }

        .matches-slider {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 16px;
            margin-bottom: 25px;
        }

        .match-card {
            background: var(--secondary);
            border: 2px solid var(--border-color);
            border-radius: 12px;
            padding: 16px;
            cursor: pointer;
            transition: all 0.2s;
            position: relative;
            overflow: hidden;
        }

        .match-card:hover {
            border-color: var(--blue-glow);
            transform: translateY(-3px);
        }

        .match-card.active {
            border-color: var(--accent);
            background: #24344d;
        }

        .match-card.active::after {
            content: "SELECTED";
            position: absolute;
            top: 10px;
            right: -25px;
            background: var(--accent);
            color: #000;
            font-size: 0.65rem;
            font-weight: 800;
            padding: 2px 25px;
            transform: rotate(45deg);
        }

        .match-teams {
            font-size: 1.1rem;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .match-meta {
            font-size: 0.8rem;
            color: var(--text-muted);
            line-height: 1.5;
        }

        /* STADIUM ARENA LAYOUT */
        .arena-grid {
            display: grid;
            grid-template-columns: 1fr 340px;
            gap: 25px;
        }

        @media (max-width: 992px) {
            .arena-grid {
                grid-template-columns: 1fr;
            }
        }

        .stadium-wrapper {
            background: var(--secondary);
            border-radius: 16px;
            border: 1px solid var(--border-color);
            padding: 25px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        /* Stadium Stand Selector Buttons */
        .stands-nav {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            justify-content: center;
            margin-bottom: 25px;
            width: 100%;
        }

        .stand-btn {
            background: #283548;
            border: 1px solid var(--border-color);
            color: var(--text-muted);
            padding: 10px 18px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.85rem;
            transition: 0.2s;
        }

        .stand-btn:hover {
            color: white;
            border-color: var(--accent);
        }

        .stand-btn.active {
            background: var(--accent);
            color: #000;
            border-color: var(--accent);
        }

        /* Field & Pitch */
        .pitch-container {
            width: 90%;
            height: 50px;
            background: var(--pitch-green);
            border: 2px dashed #10b981;
            border-radius: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            letter-spacing: 3px;
            font-size: 0.85rem;
            color: #6ee7b7;
            text-transform: uppercase;
            margin-bottom: 25px;
            box-shadow: inset 0 0 15px rgba(0,0,0,0.5);
        }

        /* Stadium Seating Matrix */
        .stadium-matrix-container {
            width: 100%;
            overflow-x: auto;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding-bottom: 10px;
        }

        .stand-title {
            font-size: 1rem;
            font-weight: 700;
            color: var(--text-muted);
            margin-bottom: 15px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .stadium-block {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .seat-row {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .row-label {
            font-size: 0.8rem;
            font-weight: 700;
            color: var(--text-muted);
            width: 24px;
            text-align: center;
        }

        .aisle-gap {
            width: 20px;
        }

        .seat {
            width: 28px;
            height: 28px;
            background-color: var(--seat-avail);
            border-radius: 5px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.7rem;
            font-weight: 600;
            color: #cbd5e1;
            transition: all 0.15s ease;
            user-select: none;
        }

        .seat:hover:not(.booked) {
            transform: scale(1.18);
            background-color: var(--blue-glow);
            color: #fff;
            z-index: 2;
        }

        .seat.selected {
            background-color: var(--seat-selected) !important;
            color: white !important;
            box-shadow: 0 0 10px rgba(16, 185, 129, 0.6);
        }

        .seat.booked {
            background-color: var(--seat-booked) !important;
            cursor: not-allowed;
            opacity: 0.45;
            color: #fff;
        }

        /* Seating Legend */
        .legend-bar {
            display: flex;
            gap: 20px;
            margin-top: 25px;
            padding-top: 15px;
            border-top: 1px solid var(--border-color);
            flex-wrap: wrap;
            justify-content: center;
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        .legend-pill {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .legend-circle {
            width: 14px;
            height: 14px;
            border-radius: 4px;
        }

        /* Checkout Sidebar Summary */
        .summary-card {
            background: var(--secondary);
            border-radius: 16px;
            border: 1px solid var(--border-color);
            padding: 24px;
            display: flex;
            flex-direction: column;
            height: fit-content;
            box-shadow: 0 10px 25px rgba(0,0,0,0.3);
        }

        .summary-header {
            font-size: 1.15rem;
            font-weight: 700;
            margin-bottom: 18px;
            padding-bottom: 12px;
            border-bottom: 1px solid var(--border-color);
            color: var(--accent);
        }

        .summary-item {
            display: flex;
            justify-content: space-between;
            margin-bottom: 14px;
            font-size: 0.9rem;
            line-height: 1.4;
        }

        .summary-item .label {
            color: var(--text-muted);
        }

        .summary-item .value {
            font-weight: 600;
            text-align: right;
            max-width: 60%;
        }

        .selected-tags-container {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            justify-content: flex-end;
        }

        .seat-tag {
            background: #064e3b;
            color: #6ee7b7;
            font-size: 0.75rem;
            padding: 2px 7px;
            border-radius: 4px;
            font-weight: 700;
        }

        .summary-divider {
            height: 1px;
            background: var(--border-color);
            margin: 15px 0;
        }

        .summary-total {
            display: flex;
            justify-content: space-between;
            font-size: 1.3rem;
            font-weight: 800;
            color: #fff;
            margin-bottom: 20px;
        }

        .summary-total span:last-child {
            color: var(--accent);
        }

        .btn-checkout {
            background: var(--accent);
            color: #000;
            border: none;
            padding: 14px;
            border-radius: 10px;
            font-size: 1rem;
            font-weight: 800;
            cursor: pointer;
            transition: background-color 0.2s;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .btn-checkout:hover:not(:disabled) {
            background: var(--accent-hover);
        }

        .btn-checkout:disabled {
            background: #334155;
            color: #64748b;
            cursor: not-allowed;
        }

        /* OTHER TABS: FIXTURES & STANDINGS */
        .table-card {
            background: var(--secondary);
            border-radius: 12px;
            border: 1px solid var(--border-color);
            overflow: hidden;
            width: 100%;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            font-size: 0.95rem;
        }

        th, td {
            padding: 14px 20px;
            border-bottom: 1px solid var(--border-color);
        }

        th {
            background: #111827;
            color: var(--text-muted);
            text-transform: uppercase;
            font-size: 0.8rem;
            letter-spacing: 0.5px;
        }

        tr:hover td {
            background: rgba(255,255,255,0.02);
        }

        /* MY TICKETS TAB */
        .tickets-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 20px;
        }

        .ticket-item-card {
            background: linear-gradient(135deg, #1e293b, #0f172a);
            border: 1px solid var(--border-color);
            border-left: 6px solid var(--accent);
            border-radius: 12px;
            padding: 20px;
            position: relative;
        }

        .ticket-item-card h4 {
            font-size: 1.1rem;
            margin-bottom: 8px;
            color: #fff;
        }

        .ticket-item-card p {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 6px;
        }

        .ticket-id-badge {
            background: rgba(245, 158, 11, 0.15);
            color: var(--accent);
            font-family: monospace;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 0.8rem;
            display: inline-block;
            margin-top: 10px;
        }

        /* CONFIRMATION POPUP MODAL */
        .modal-backdrop {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.85);
            backdrop-filter: blur(4px);
            z-index: 100;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .modal-backdrop.open {
            display: flex;
        }

        .e-ticket {
            background: #ffffff;
            color: #0f172a;
            max-width: 440px;
            width: 100%;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 25px 50px rgba(0,0,0,0.7);
        }

        .e-ticket-header {
            background: #1e3a8a;
            color: white;
            padding: 24px;
            text-align: center;
        }

        .e-ticket-body {
            padding: 24px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            font-size: 0.95rem;
        }

        .ticket-qr-dummy {
            height: 70px;
            background: repeating-linear-gradient(90deg, #000, #000 3px, #fff 3px, #fff 7px);
            margin: 10px 0;
            border-radius: 4px;
        }

        .btn-modal-close {
            background: #1e3a8a;
            color: white;
            border: none;
            width: 100%;
            padding: 12px;
            font-size: 1rem;
            font-weight: 700;
            border-radius: 8px;
            cursor: pointer;
            margin-top: 10px;
        }
    </style>
</head>
<body>

    <!-- TOP HEADER WITH TABS -->
    <header>
        <div class="header-content">
            <div class="logo">
                🏏 <span>IPL Box Office</span>
            </div>
            <nav class="nav-tabs">
                <button class="tab-btn active" onclick="switchTab('bookingTab', this)">🏟️ Stadium Seats</button>
                <button class="tab-btn" onclick="switchTab('scheduleTab', this)">📅 Fixtures</button>
                <button class="tab-btn" onclick="switchTab('standingsTab', this)">🏆 Points Table</button>
                <button class="tab-btn" onclick="switchTab('myTicketsTab', this)">🎟️ My Tickets (<span id="ticketCount">0</span>)</button>
            </nav>
        </div>
    </header>

    <div class="container">

        <!-- TAB 1: STADIUM SEAT BOOKING -->
        <div id="bookingTab" class="tab-panel active">
            
            <div class="section-header">
                <h2 class="section-title">1. Select Match Fixture</h2>
            </div>
            <div class="matches-slider" id="matchesContainer"></div>

            <div class="section-header">
                <h2 class="section-title">2. Choose Stand & Select Seats</h2>
            </div>

            <div class="arena-grid">
                <!-- Stadium Workspace -->
                <div class="stadium-wrapper">
                    
                    <!-- Stand Switcher -->
                    <div class="stands-nav">
                        <button class="stand-btn active" onclick="switchStand('North', 1500, this)">North Stand (₹1,500)</button>
                        <button class="stand-btn" onclick="switchStand('East', 2800, this)">East Stand (₹2,800)</button>
                        <button class="stand-btn" onclick="switchStand('Pavilion', 4500, this)">South Pavilion (₹4,500)</button>
                        <button class="stand-btn" onclick="switchStand('VIP', 9500, this)">VIP Corporate Lounge (₹9,500)</button>
                    </div>

                    <!-- Ground / Pitch Indicator -->
                    <div class="pitch-container">
                        🌱 CRICKET PITCH / OUTFIELD AREA 🌱
                    </div>

                    <!-- Stadium Matrix -->
                    <div class="stadium-matrix-container">
                        <div class="stand-title" id="currentStandTitle">North Stand - Tier 1</div>
                        <div class="stadium-block" id="seatMatrix"></div>
                    </div>

                    <!-- Legend -->
                    <div class="legend-bar">
                        <div class="legend-pill">
                            <div class="legend-circle" style="background: var(--seat-avail);"></div> Available
                        </div>
                        <div class="legend-pill">
                            <div class="legend-circle" style="background: var(--seat-selected);"></div> Selected
                        </div>
                        <div class="legend-pill">
                            <div class="legend-circle" style="background: var(--seat-booked);"></div> Occupied / Sold Out
                        </div>
                    </div>
                </div>

                <!-- Order Checkout Card -->
                <div class="summary-card">
                    <div class="summary-header">Booking Summary</div>
                    
                    <div class="summary-item">
                        <span class="label">Match:</span>
                        <span class="value" id="sumMatch">-</span>
                    </div>
                    <div class="summary-item">
                        <span class="label">Stand:</span>
                        <span class="value" id="sumStand">North Stand</span>
                    </div>
                    <div class="summary-item">
                        <span class="label">Price per Seat:</span>
                        <span class="value" id="sumPrice">₹1,500</span>
                    </div>
                    <div class="summary-item">
                        <span class="label">Selected Seats:</span>
                        <div class="selected-tags-container" id="sumSeatList">
                            <span style="color: var(--text-muted); font-size: 0.85rem;">None</span>
                        </div>
                    </div>

                    <div class="summary-divider"></div>

                    <div class="summary-item">
                        <span class="label">Booking Fee & GST:</span>
                        <span class="value" id="sumTax">₹0</span>
                    </div>

                    <div class="summary-total">
                        <span>Total:</span>
                        <span id="sumTotal">₹0</span>
                    </div>

                    <button class="btn-checkout" id="btnCheckout" disabled onclick="handleBooking()">Proceed to Pay</button>
                </div>
            </div>
        </div>

        <!-- TAB 2: SCHEDULE & FIXTURES -->
        <div id="scheduleTab" class="tab-panel">
            <div class="section-header">
                <h2 class="section-title">Official IPL 2026 Match Schedule</h2>
            </div>
            <div class="table-card">
                <table>
                    <thead>
                        <tr>
                            <th>Match No</th>
                            <th>Teams</th>
                            <th>Venue</th>
                            <th>Date & Time</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Match 01</td>
                            <td><strong>CSK vs RCB</strong></td>
                            <td>M. A. Chidambaram Stadium, Chennai</td>
                            <td>Apr 18, 2026 - 7:30 PM</td>
                            <td><span style="color: #10b981;">Open for Booking</span></td>
                        </tr>
                        <tr>
                            <td>Match 02</td>
                            <td><strong>MI vs KKR</strong></td>
                            <td>Wankhede Stadium, Mumbai</td>
                            <td>Apr 20, 2026 - 7:30 PM</td>
                            <td><span style="color: #10b981;">Open for Booking</span></td>
                        </tr>
                        <tr>
                            <td>Match 03</td>
                            <td><strong>GT vs RR</strong></td>
                            <td>Narendra Modi Stadium, Ahmedabad</td>
                            <td>Apr 22, 2026 - 7:30 PM</td>
                            <td><span style="color: #10b981;">Open for Booking</span></td>
                        </tr>
                        <tr>
                            <td>Match 04</td>
                            <td><strong>DC vs SRH</strong></td>
                            <td>Arun Jaitley Stadium, Delhi</td>
                            <td>Apr 24, 2026 - 7:30 PM</td>
                            <td><span style="color: #f59e0b;">Opening Soon</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TAB 3: STANDINGS / POINTS TABLE -->
        <div id="standingsTab" class="tab-panel">
            <div class="section-header">
                <h2 class="section-title">IPL 2026 Tournament Standings</h2>
            </div>
            <div class="table-card">
                <table>
                    <thead>
                        <tr>
                            <th>Pos</th>
                            <th>Team</th>
                            <th>Played</th>
                            <th>Won</th>
                            <th>Lost</th>
                            <th>NRR</th>
                            <th>Points</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td>1</td><td><strong>Chennai Super Kings (CSK)</strong></td><td>0</td><td>0</td><td>0</td><td>+0.000</td><td>0</td></tr>
                        <tr><td>2</td><td><strong>Royal Challengers Bengaluru (RCB)</strong></td><td>0</td><td>0</td><td>0</td><td>+0.000</td><td>0</td></tr>
                        <tr><td>3</td><td><strong>Mumbai Indians (MI)</strong></td><td>0</td><td>0</td><td>0</td><td>+0.000</td><td>0</td></tr>
                        <tr><td>4</td><td><strong>Kolkata Knight Riders (KKR)</strong></td><td>0</td><td>0</td><td>0</td><td>+0.000</td><td>0</td></tr>
                        <tr><td>5</td><td><strong>Gujarat Titans (GT)</strong></td><td>0</td><td>0</td><td>0</td><td>+0.000</td><td>0</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TAB 4: MY BOOKED TICKETS -->
        <div id="myTicketsTab" class="tab-panel">
            <div class="section-header">
                <h2 class="section-title">My Match Bookings & Passes</h2>
            </div>
            <div id="myTicketsContainer" class="tickets-list">
                <p style="color: var(--text-muted);">You haven't booked any tickets yet. Pick a match and reserve your seats!</p>
            </div>
        </div>

    </div>

    <!-- E-TICKET CONFIRMATION MODAL -->
    <div class="modal-backdrop" id="ticketModal">
        <div class="e-ticket">
            <div class="e-ticket-header">
                <h2 style="font-size: 1.3rem;">🎉 Booking Confirmed!</h2>
                <p style="font-size: 0.85rem; opacity: 0.9; margin-top: 4px;">IPL Official Stadium Entry Pass</p>
            </div>
            <div class="e-ticket-body">
                <div><strong>Match:</strong> <span id="mTicketMatch"></span></div>
                <div><strong>Venue:</strong> <span id="mTicketVenue"></span></div>
                <div><strong>Stand:</strong> <span id="mTicketStand"></span></div>
                <div><strong>Seat Numbers:</strong> <span id="mTicketSeats" style="font-weight: 700; color: #1e3a8a;"></span></div>
                <div><strong>Total Paid:</strong> <span id="mTicketAmount"></span></div>
                <div class="ticket-qr-dummy"></div>
                <div style="font-size: 0.8rem; color: #64748b; text-align: center;">
                    Booking Reference: <strong id="mTicketRef" style="font-family: monospace;"></strong>
                </div>
                <button class="btn-modal-close" onclick="closeModal()">Close & View My Passes</button>
            </div>
        </div>
    </div>

    <script>
        // Data Store
        const matches = [
            { id: 1, teams: "CSK vs RCB", venue: "M. A. Chidambaram Stadium, Chennai", date: "Apr 18, 2026 | 7:30 PM" },
            { id: 2, teams: "MI vs KKR", venue: "Wankhede Stadium, Mumbai", date: "Apr 20, 2026 | 7:30 PM" },
            { id: 3, teams: "GT vs RR", venue: "Narendra Modi Stadium, Ahmedabad", date: "Apr 22, 2026 | 7:30 PM" }
        ];

        // Stadium configuration: Rows A through H, 10 seats per row (80 seats per stand)
        const ROWS = ["A", "B", "C", "D", "E", "F", "G", "H"];
        const SEATS_PER_ROW = 10;

        // Persistent in-memory registry of booked seats: Format "matchId-Stand-RowSeat" (e.g., "1-North-A3")
        const occupiedRegistry = new Set([
            "1-North-A3", "1-North-A4", "1-North-C6", "1-North-E7",
            "1-VIP-A1", "1-VIP-A2", "2-North-B5"
        ]);

        const userBookings = [];

        let currentMatch = matches[0];
        let currentStand = "North";
        let currentPrice = 1500;
        let selectedSeats = []; // Array of seat keys like ["A1", "A2"]

        // Switch Tabs Handler
        function switchTab(tabId, buttonElement) {
            document.querySelectorAll(".tab-panel").forEach(panel => panel.classList.remove("active"));
            document.querySelectorAll(".nav-tabs .tab-btn").forEach(btn => btn.classList.remove("active"));
            
            document.getElementById(tabId).classList.add("active");
            buttonElement.classList.add("active");

            if (tabId === "myTicketsTab") {
                renderMyTickets();
            }
        }

        // Render Match Selection Cards
        function renderMatches() {
            const container = document.getElementById("matchesContainer");
            container.innerHTML = "";
            matches.forEach((m, idx) => {
                const card = document.createElement("div");
                card.className = `match-card ${idx === 0 ? 'active' : ''}`;
                card.onclick = () => {
                    document.querySelectorAll(".match-card").forEach(c => c.classList.remove("active"));
                    card.classList.add("active");
                    currentMatch = m;
                    selectedSeats = [];
                    updateSummary();
                    renderStadium();
                };
                card.innerHTML = `
                    <div class="match-teams">${m.teams}</div>
                    <div class="match-meta">📍 ${m.venue}</div>
                    <div class="match-meta" style="color: var(--accent); font-weight: 600; margin-top: 4px;">📅 ${m.date}</div>
                `;
                container.appendChild(card);
            });
            document.getElementById("sumMatch").innerText = currentMatch.teams;
        }

        // Switch Stand Handler
        function switchStand(standName, price, btn) {
            document.querySelectorAll(".stand-btn").forEach(b => b.classList.remove("active"));
            btn.classList.add("active");
            currentStand = standName;
            currentPrice = price;
            selectedSeats = []; // Reset selected seats on stand switch

            document.getElementById("currentStandTitle").innerText = `${standName} Stand - Sector View`;
            document.getElementById("sumStand").innerText = `${standName} Stand`;
            document.getElementById("sumPrice").innerText = `₹${price.toLocaleString("en-IN")}`;

            updateSummary();
            renderStadium();
        }

        // Render 80 Realistic Stadium Seats with Aisles
        function renderStadium() {
            const matrix = document.getElementById("seatMatrix");
            matrix.innerHTML = "";

            ROWS.forEach(row => {
                const rowDiv = document.createElement("div");
                rowDiv.className = "seat-row";

                // Left row letter label
                const labelLeft = document.createElement("span");
                labelLeft.className = "row-label";
                labelLeft.innerText = row;
                rowDiv.appendChild(labelLeft);

                for (let num = 1; num <= SEATS_PER_ROW; num++) {
                    // Create central stadium walkway aisle after 5 seats
                    if (num === 6) {
                        const aisle = document.createElement("div");
                        aisle.className = "aisle-gap";
                        rowDiv.appendChild(aisle);
                    }

                    const seatCode = `${row}${num}`;
                    const globalKey = `${currentMatch.id}-${currentStand}-${seatCode}`;
                    
                    const seat = document.createElement("div");
                    seat.className = "seat";
                    seat.innerText = num;

                    if (occupiedRegistry.has(globalKey)) {
                        seat.classList.add("booked");
                        seat.title = `Seat ${seatCode} (Occupied)`;
                    } else {
                        if (selectedSeats.includes(seatCode)) {
                            seat.classList.add("selected");
                        }
                        seat.title = `Seat ${seatCode} - ₹${currentPrice}`;
                        seat.onclick = () => toggleSeat(seat, seatCode);
                    }

                    rowDiv.appendChild(seat);
                }

                // Right row letter label
                const labelRight = document.createElement("span");
                labelRight.className = "row-label";
                labelRight.innerText = row;
                rowDiv.appendChild(labelRight);

                matrix.appendChild(rowDiv);
            });
        }

        function toggleSeat(seatEl, seatCode) {
            if (selectedSeats.includes(seatCode)) {
                selectedSeats = selectedSeats.filter(s => s !== seatCode);
                seatEl.classList.remove("selected");
            } else {
                if (selectedSeats.length >= 6) {
                    alert("Maximum 6 tickets can be booked at once.");
                    return;
                }
                selectedSeats.push(seatCode);
                seatEl.classList.add("selected");
            }
            updateSummary();
        }

        function updateSummary() {
            const tagContainer = document.getElementById("sumSeatList");
            const taxEl = document.getElementById("sumTax");
            const totalEl = document.getElementById("sumTotal");
            const btn = document.getElementById("btnCheckout");

            if (selectedSeats.length === 0) {
                tagContainer.innerHTML = `<span style="color: var(--text-muted); font-size: 0.85rem;">None</span>`;
                taxEl.innerText = "₹0";
                totalEl.innerText = "₹0";
                btn.disabled = true;
                return;
            }

            tagContainer.innerHTML = "";
            selectedSeats.forEach(st => {
                const tag = document.createElement("span");
                tag.className = "seat-tag";
                tag.innerText = `${currentStand[0]}-${st}`;
                tagContainer.appendChild(tag);
            });

            const subtotal = selectedSeats.length * currentPrice;
            const taxes = Math.round(subtotal * 0.18); // 18% GST calculation
            const grandTotal = subtotal + taxes;

            taxEl.innerText = `₹${taxes.toLocaleString("en-IN")}`;
            totalEl.innerText = `₹${grandTotal.toLocaleString("en-IN")}`;
            btn.disabled = false;
        }

        // Handle Booking & Ticket Creation
        function handleBooking() {
            const subtotal = selectedSeats.length * currentPrice;
            const taxes = Math.round(subtotal * 0.18);
            const grandTotal = subtotal + taxes;
            const refCode = "IPL-" + Math.floor(100000 + Math.random() * 900000);
            const seatListFormatted = selectedSeats.map(s => `${currentStand[0]}-${s}`).join(", ");

            // Save to Bookings
            userBookings.push({
                ref: refCode,
                match: currentMatch.teams,
                venue: currentMatch.venue,
                date: currentMatch.date,
                stand: currentStand + " Stand",
                seats: seatListFormatted,
                total: "₹" + grandTotal.toLocaleString("en-IN")
            });

            // Mark seats permanently occupied in the registry
            selectedSeats.forEach(st => {
                occupiedRegistry.add(`${currentMatch.id}-${currentStand}-${st}`);
            });

            // Fill Modal
            document.getElementById("mTicketMatch").innerText = currentMatch.teams;
            document.getElementById("mTicketVenue").innerText = currentMatch.venue;
            document.getElementById("mTicketStand").innerText = currentStand + " Stand";
            document.getElementById("mTicketSeats").innerText = seatListFormatted;
            document.getElementById("mTicketAmount").innerText = "₹" + grandTotal.toLocaleString("en-IN");
            document.getElementById("mTicketRef").innerText = refCode;

            // Update badge count
            document.getElementById("ticketCount").innerText = userBookings.length;

            // Show Confirmation
            document.getElementById("ticketModal").classList.add("open");
        }

        function closeModal() {
            document.getElementById("ticketModal").classList.remove("open");
            selectedSeats = [];
            renderStadium();
            updateSummary();
        }

        // Render My Tickets Tab
        function renderMyTickets() {
            const container = document.getElementById("myTicketsContainer");
            if (userBookings.length === 0) {
                container.innerHTML = `<p style="color: var(--text-muted); grid-column: 1/-1;">You haven't booked any tickets yet. Pick a match and reserve your seats!</p>`;
                return;
            }

            container.innerHTML = "";
            userBookings.forEach(ticket => {
                const card = document.createElement("div");
                card.className = "ticket-item-card";
                card.innerHTML = `
                    <h4>${ticket.match}</h4>
                    <p>📍 ${ticket.venue}</p>
                    <p>📅 ${ticket.date}</p>
                    <p>🪑 <strong>Stand:</strong> ${ticket.stand}</p>
                    <p>🎟️ <strong>Seats:</strong> ${ticket.seats}</p>
                    <p>💵 <strong>Amount:</strong> ${ticket.total}</p>
                    <span class="ticket-id-badge">PASS ID: ${ticket.ref}</span>
                `;
                container.appendChild(card);
            });
        }

        // Initialize on DOM Load
        document.addEventListener("DOMContentLoaded", () => {
            renderMatches();
            renderStadium();
            updateSummary();
        });
    </script>
</body>
</html>
